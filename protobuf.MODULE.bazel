# All the Bazel stuff required to have protobuf and grpc available
#
# Copied from: https://github.com/bazelbuild/rules_rust/blob/main/examples/bzlmod/proto/MODULE.bazel

PROTOBUF_VERSION = "33.0"

bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_proto_grpc", version = "5.8.0")
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.8.0")
bazel_dep(name = "rules_proto_grpc_js", version = "5.8.0")
bazel_dep(name = "toolchains_protoc", version = "0.6.0")
bazel_dep(name = "protobuf", version = PROTOBUF_VERSION)
bazel_dep(name = "rules_rust_prost", version = "0.67.0")

# 2 Register Proto toolchain
###############################################################################
# Proto toolchain
protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(
    google_protobuf = "com_google_protobuf",
    version = "v{}".format(PROTOBUF_VERSION),
)

# Custom Prost toolchain
register_toolchains("@//bazel/rust/prost:prost_toolchain")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "protoc-gen-prost",
    version = "0.4.0",
)
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.spec(
    package = "protoc-gen-tonic",
    version = "0.4.1",
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)
crate.from_specs(
    name = "crates_protoc",
    supported_platform_triples = [
        # "aarch64-apple-darwin",
        # "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates_protoc")

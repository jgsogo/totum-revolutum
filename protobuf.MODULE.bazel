# All the Bazel stuff required to have protobuf available
#
# Copied from: https://github.com/bazelbuild/rules_rust/blob/main/examples/bzlmod/proto/MODULE.bazel

# rules for proto
###############################################################################
# https://github.com/bazelbuild/rules_proto/releases
bazel_dep(name = "rules_proto", version = "7.1.0")

# https://github.com/aspect-build/toolchains_protoc/releases
bazel_dep(name = "toolchains_protoc", version = "0.3.6")

# https://registry.bazel.build/modules/protobuf
bazel_dep(name = "protobuf", version = "29.2")

# rules for LLVM
# https://github.com/bazel-contrib/toolchains_llvm
bazel_dep(name = "toolchains_llvm", version = "1.2.0")
bazel_dep(name = "rules_rust_prost", version = "0.56.0")

# FIXME: Override rules_rust to add this patch: https://github.com/bazelbuild/rules_rust/pull/3102, required for the protobuf-stuff
archive_override(
    module_name = "rules_rust",
    integrity = "sha256-GtOMBT3FH1/Wmdfsp/mi5gYltPeulIwTxHDnSU04fu4=",
    patch_strip = 1,
    patches = [
        "@//bazel/external:rules_rust_0001-Workspace_members.patch",
    ],
    strip_prefix = "rules_rust-89aec557796a3a404f3458b8643a85d49a789b83",
    urls = ["https://github.com/bazelbuild/rules_rust/archive/89aec557796a3a404f3458b8643a85d49a789b83.tar.gz"],
)

# 1 Register LLVM
###############################################################################
# L L V M
# https://github.com/bazel-contrib/toolchains_llvm/blob/master/tests/MODULE.bazel
###############################################################################
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

# LLVM Versions and platforms
# https://github.com/bazel-contrib/toolchains_llvm/blob/master/toolchain/internal/llvm_distributions.bzl
LLVM_VERSIONS = {
    "": "19.1.0",
    # "darwin-aarch64": "16.0.3",
    # "darwin-x86_64": "15.0.7",
}

# LLVM toolchain.
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_versions = LLVM_VERSIONS,
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")

# 2 Register Proto toolchain
###############################################################################
# Proto toolchain
# register_toolchains("@rules_rust_prost//:default_prost_toolchain")

# Custom Prost toolchain
register_toolchains("@//bazel/rust/prost:prost_toolchain")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "prost",
    version = "0.13.4",
)
crate.spec(
    default_features = False,
    package = "prost-types",
    version = "0.13.1",
)
crate.spec(
    features = ["transport"],
    package = "tonic",
    version = "0.12.3",
)
crate.spec(
    package = "tonic-build",
    version = "0.12.3",
)
crate.spec(
    package = "protoc-gen-prost",
    version = "0.4.0",
)
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.spec(
    package = "protoc-gen-tonic",
    version = "0.4.1",
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)
crate.from_specs(name = "crates_protoc")
use_repo(crate, "crates_protoc")

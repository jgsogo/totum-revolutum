# All the Bazel stuff required to have protobuf available
#
# Copied from: https://github.com/bazelbuild/rules_rust/blob/main/examples/bzlmod/proto/MODULE.bazel

bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "toolchains_protoc", version = "0.3.7")
bazel_dep(name = "protobuf", version = "29.3")
bazel_dep(name = "toolchains_llvm", version = "1.2.0")
bazel_dep(name = "rules_rust_prost", version = "0.56.0")
bazel_dep(name = "llvm")

single_version_override(
    module_name = "toolchains_llvm",
    patch_strip = 1,
    patches = ["//bazel/external:toolchains_llvm-0001-Revert-undefined-dynamic-lookup-darwin.patch"],
    version = "1.3.0",
)

local_path_override(
    module_name = "llvm",
    path = "tools/llvm-17.0.6",
)

###############################################################################
# L L V M
#
# TODO: This LLVM stuff is related to C++, move it outside this protobuf related module
# https://github.com/bazel-contrib/toolchains_llvm/blob/master/tests/MODULE.bazel
###############################################################################
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)

# LLVM Versions and platforms
# https://github.com/bazel-contrib/toolchains_llvm/blob/master/toolchain/internal/llvm_distributions.bzl

# LLVM toolchain.
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "17.0.6",
    # absolute_paths = False,
    # llvm_versions = LLVM_VERSIONS,
)
# llvm.toolchain_root(
#     name = "llvm_toolchain",
#     label = "@llvm//:BUILD"
# )
# use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# llvm.toolchain(
#     name = "llvm_toolchain",
#     # label = "@llvm//:clang"
#     toolchain_roots = {
#         # "linux": "@llvm/:BUILD",
#         "darwin-x86_64": "@llvm//:clang",
#     },
# )

llvm.toolchain_root(
    name = "llvm_toolchain",
    # path = "/Users/jgsogo/personal/totum-revolut/tools/llvm-17.0.6",
    label = "@llvm//:clang",
)

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

use_repo(llvm, "llvm_toolchain")

# 2 Register Proto toolchain
###############################################################################
# Proto toolchain
# register_toolchains("@rules_rust_prost//:default_prost_toolchain")

# Custom Prost toolchain
register_toolchains("@//bazel/rust/prost:prost_toolchain")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "protoc-gen-prost",
    version = "0.4.0",
)
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.spec(
    package = "protoc-gen-tonic",
    version = "0.4.1",
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)
crate.from_specs(name = "crates_protoc")
use_repo(crate, "crates_protoc")

# All the Bazel stuff required to have protobuf available
#
# Copied from: https://github.com/bazelbuild/rules_rust/blob/main/examples/bzlmod/proto/MODULE.bazel

bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "toolchains_protoc", version = "0.3.7")
bazel_dep(name = "protobuf", version = "30.2")
bazel_dep(name = "rules_rust_prost", version = "0.57.1")  # It has to match the version of `rules_rust`

# 2 Register Proto toolchain
###############################################################################
# Proto toolchain
# register_toolchains("@rules_rust_prost//:default_prost_toolchain")

# Custom Prost toolchain
register_toolchains(
    "@//bazel/rust/prost:prost_toolchain",
    "@//bazel/rust/prost:proto_toolchain",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "protoc-gen-prost",
    version = "0.4.0",
)
crate.annotation(
    crate = "protoc-gen-prost",
    gen_binaries = ["protoc-gen-prost"],
)
crate.spec(
    package = "protoc-gen-tonic",
    version = "0.4.1",
)
crate.annotation(
    crate = "protoc-gen-tonic",
    gen_binaries = ["protoc-gen-tonic"],
)
crate.from_specs(name = "crates_protoc")
use_repo(crate, "crates_protoc")

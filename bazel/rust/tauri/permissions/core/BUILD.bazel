load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("//bazel/rust/tauri/permissions:plugin_permissions.bzl", "plugin_permissions")

run_binary(
    name = "tar",
    srcs = ["@crates__tauri-2.4.1//:build_script_build"],
    outs = ["permissions.tar"],
    args = [
        "$(location @crates__tauri-2.4.1//:build_script_build)/tauri-core-app-permission-files",
        "$(location @crates__tauri-2.4.1//:build_script_build)",
        "$@",
    ],
    tool = "//bazel/rust/tauri/permissions:tar_from_json_relative.sh",
)

genrule(
    name = "app",
    srcs = [
        "@crates__tauri-2.4.1//:build_script_build",
        "//bazel/rust/tauri/permissions:tar_from_json_relative.sh",
    ],
    outs = ["lol.txt"],
    cmd = "$(location //bazel/rust/tauri/permissions:tar_from_json_relative.sh) $(location @crates__tauri-2.4.1//:build_script_build)/tauri-core-app-permission-files $(location @crates__tauri-2.4.1//:build_script_build) $@",
)

plugin_permissions(
    name = "core",
    # srcs = ["@crates__tauri-2.4.1//:build_script_build",],
    build_script = "@crates__tauri-2.4.1//:build_script_build",
    inner_path = "app/autogenerated",
)

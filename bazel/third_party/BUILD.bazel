load("@rules_rust//crate_universe:defs.bzl", "crate", "crates_vendor")
load("@rules_uv//uv:pip.bzl", "pip_compile")

pip_compile(
    name = "python_requirements",
    python_platform = "x86_64-unknown-linux-gnu",
    requirements_in = ":requirements.in",
    requirements_txt = "requirements.lock",
    tags = ["no-sandbox"],
)

crates_vendor(
    name = "crates_vendor",
    annotations = {
        "tauri": [crate.annotation(
            additive_build_file_content = """
                [
                    genrule(
                        name = "tauri-{}-permission-files".format(it),
                        srcs = [
                            ":build_script_build",
                        ],
                        cmd = '''
                            STRIP_PREFIX="$(location :build_script_build)"
                            TMP_DIR=$$(mktemp -d)
                            jq -r '.[]' "$(location :build_script_build)/tauri-{}-permission-files" | while read -r file; do
                                relative_path="$${{file#*$$STRIP_PREFIX/}}"
                                dest="$$TMP_DIR/$$relative_path"
                                mkdir -p "$$(dirname "$$dest")"
                                cp "$(location :build_script_build)/$$relative_path" "$$dest"
                            done
                            tar -czf "$@" -C "$$TMP_DIR" .
                            rm -fr $$TMP_DIR
                        '''.format(it),
                        outs = [
                            "tauri-{}-permission-files.tar".format(it),
                        ],
                        tags = ["manual"],
                    )
                for it in ['core', 'core-app', 'core-event', 'core-image', 'core-menu', 'core-path', 'core-resources', 'core-tray', 'core-webview', 'core-window']]
            """,
        )],
        "tauri-plugin-log": [crate.annotation(
            additive_build_file_content = """
                genrule(
                    name = "tauri-plugin-log-permission-files",
                    srcs = [
                        ":build_script_build",
                    ],
                    cmd = '''
                        STRIP_PREFIX="permissions"
                        TMP_DIR=$$(mktemp -d)
                        jq -r '.[]' "$(location :build_script_build)/tauri-plugin-log-permission-files" | while read -r file; do
                            relative_path="$${file#*$$STRIP_PREFIX/}"
                            dest="$$TMP_DIR/permissions/$$relative_path"
                            mkdir -p "$$(dirname "$$dest")"
                            cp "$$file" "$$dest"
                        done
                        tar -czf "$@" -C "$$TMP_DIR" .
                        rm -fr $$TMP_DIR
                    ''',
                    outs = [
                        "tauri-plugin-log-permission-files.tar",
                    ],
                    tags = ["manual"],
                )
            """,
        )],
        "tauri-plugin-shell": [crate.annotation(
            additive_build_file_content = """
                genrule(
                    name = "tauri-plugin-shell-permission-files",
                    srcs = [
                        ":build_script_build",
                    ],
                    cmd = '''
                        STRIP_PREFIX="permissions"
                        TMP_DIR=$$(mktemp -d)
                        jq -r '.[]' "$(location :build_script_build)/tauri-plugin-shell-permission-files" | while read -r file; do
                            relative_path="$${file#*$$STRIP_PREFIX/}"
                            dest="$$TMP_DIR/permissions/$$relative_path"
                            mkdir -p "$$(dirname "$$dest")"
                            cp "$$file" "$$dest"
                        done
                        tar -czf "$@" -C "$$TMP_DIR" .
                        rm -fr $$TMP_DIR
                    ''',
                    outs = [
                        "tauri-plugin-shell-permission-files.tar",
                    ],
                    tags = ["manual"],
                )
            """,
        )],
    },
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//apps/finances/tauri/src-tauri:Cargo.toml",
        "//apps/finances/tauri/models:Cargo.toml",
        "//apps/photodb:Cargo.toml",
        "//apps/syncronia:Cargo.toml",
        "//libraries/conductus:Cargo.toml",
        "//libraries/constants:Cargo.toml",
        "//libraries/cron:Cargo.toml",
        "//libraries/diesel_utils:Cargo.toml",
        "//libraries/filesystem:Cargo.toml",
        "//libraries/finances/accounts/rust:Cargo.toml",
        "//libraries/finances/investments/rust:Cargo.toml",
        "//libraries/googleapis:Cargo.toml",
        "//libraries/openexchangerates:Cargo.toml",
        "//libraries/pcloud_sdk:Cargo.toml",
        "//libraries/rebrickable:Cargo.toml",
        "//libraries/rust/proto_wrapper:Cargo.toml",
        "//libraries/rust/proto_wrapper_derive:Cargo.toml",
        "//libraries/utils:Cargo.toml",
        # This is added to the workspace as a workaround for binary packages (see [this note](./notes/2024-05-04-1923.md))
        "//bazel/external:Cargo.toml",
        # Sandbox apps
    ],
    mode = "remote",
    repository_name = "crates",
    supported_platform_triples = [
        # "aarch64-apple-darwin",
        # "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
    tags = ["manual"],
    vendor_path = "crates",
)

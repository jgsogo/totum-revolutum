# gunicorn
GUNICORN_APP_NAME=%NAME%
GUNICORN_WORKING_DIR=$OUTPUT_DIRECTORY
GUNICORN_USER=$(whoami)
GUNICORN_GROUP=$(id -gn jgsogo)
GUNICORN_BIND="unix:$OUTPUT_DIRECTORY/run/gunicorn.sock"

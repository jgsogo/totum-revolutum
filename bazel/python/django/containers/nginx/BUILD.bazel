load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@rules_oci//oci:defs.bzl", "oci_push")
load("//bazel/containers/buildx:image_from_dockerfile.bzl", "image_from_dockerfile")
load("//bazel/python/django/containers:defs.bzl", "DJANGO_PORT", "USER")

expand_template(
    name = "nginx_conf",
    out = "nginx.conf",
    substitutions = {
        "%USER%": USER,
        "%DJANGO_PORT%": DJANGO_PORT,
    },
    template = ":nginx.conf.tpl",
)

image_name = "nginx_django"

image_from_dockerfile(
    name = image_name,
    srcs = [
        "Dockerfile",
        ":nginx_conf",
    ],
    tags = [
        "manual",
    ],
    visibility = [
        "//visibility:public",
    ],
)

oci_push(
    name = "release",
    image = ":nginx",
    remote_tags = "//:stable_build_scm_revision",
    repository = "ghcr.io/jgsogo/{}".format(image_name),
    tags = [
        "manual",
        "no-remote-cache",
        "release",
    ],
)

load("@rules_rust//rust:defs.bzl", "rust_binary")

# Here I'm mostly translating the Cargo.toml in https://github.com/diesel-rs/diesel/blob/master/diesel_cli/Cargo.toml

rust_binary(
    name = "diesel_cli",
    srcs = glob(["diesel_cli/src/**/*.rs"]),
    compile_data = [
        "diesel_cli/src/default_files/diesel.toml",
        "diesel_cli/src/infer_schema_internals/load_foreign_keys.sql",
        "diesel_cli/src/setup_sql/postgres/initial_setup/down.sql",
        "diesel_cli/src/setup_sql/postgres/initial_setup/up.sql",
    ],
    crate_features = [
        "sqlite",
        "postgres",
        "uses_information_schema",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates__chrono-0.4.41//:chrono",
        "@crates__clap-4.5.37//:clap",
        "@crates__clap_complete-4.5.48//:clap_complete",
        "@crates__diesel-2.2.10//:diesel",
        "@crates__diesel_migrations-2.2.0//:diesel_migrations",
        "@crates__diesel_table_macro_syntax-0.2.0//:diesel_table_macro_syntax",
        "@crates__diffy-0.4.2//:diffy",
        "@crates__dotenvy-0.15.7//:dotenvy",
        "@crates__fd-lock-4.0.4//:fd_lock",
        "@crates__heck-0.5.0//:heck",
        "@crates__pq-sys-0.6.3//:pq_sys",
        "@crates__regex-1.11.1//:regex",
        "@crates__serde-1.0.219//:serde",
        "@crates__serde_regex-1.1.0//:serde_regex",
        "@crates__similar-asserts-1.7.0//:similar_asserts",
        "@crates__syn-2.0.101//:syn",
        "@crates__thiserror-2.0.12//:thiserror",
        "@crates__toml-0.8.22//:toml",
        "@crates__tracing-0.1.41//:tracing",
        "@crates__tracing-subscriber-0.3.19//:tracing_subscriber",
        "@crates__url-2.5.4//:url",
    ],
)

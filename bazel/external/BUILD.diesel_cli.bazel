load("@rules_rust//rust:defs.bzl", "rust_binary")

# Here I'm mostly translating the Cargo.toml in https://github.com/diesel-rs/diesel/blob/master/diesel_cli/Cargo.toml

rust_binary(
    name = "diesel_cli",
    srcs = glob(["diesel_cli/src/**/*.rs"]),
    compile_data = [
        "diesel_cli/src/default_files/diesel.toml",
        "diesel_cli/src/infer_schema_internals/load_foreign_keys.sql",
        "diesel_cli/src/setup_sql/postgres/initial_setup/down.sql",
        "diesel_cli/src/setup_sql/postgres/initial_setup/up.sql",
    ],
    crate_features = [
        "sqlite",
        "postgres",
        "uses_information_schema",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:chrono",
        "@crates//:clap",
        "@crates//:clap_complete",
        "@crates//:diesel",
        "@crates//:diesel_migrations",
        "@crates//:diesel_table_macro_syntax",
        "@crates//:diffy",
        "@crates//:dotenvy",
        "@crates//:fd-lock",
        "@crates//:heck",
        "@crates//:pq-sys",
        "@crates//:regex",
        "@crates//:serde",
        "@crates//:serde_regex",
        "@crates//:similar-asserts",
        "@crates//:syn",
        "@crates//:thiserror",
        "@crates//:toml",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:url",
    ],
)

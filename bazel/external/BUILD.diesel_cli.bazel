load("@rules_rust//rust:defs.bzl", "rust_binary")

# Here I'm mostly translating the Cargo.toml in https://github.com/diesel-rs/diesel/blob/master/diesel_cli/Cargo.toml

rust_binary(
    name = "diesel_cli",
    srcs = glob(["diesel_cli/src/**/*.rs"]),
    compile_data = [
        "diesel_cli/src/default_files/diesel.toml",
        "diesel_cli/src/infer_schema_internals/load_foreign_keys.sql",
        "diesel_cli/src/setup_sql/postgres/initial_setup/down.sql",
        "diesel_cli/src/setup_sql/postgres/initial_setup/up.sql",
    ],
    crate_features = [
        "sqlite",
        "postgres",
        "uses_information_schema",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates_libraries//:chrono",
        "@crates_libraries//:clap",
        "@crates_libraries//:clap_complete",
        "@crates_libraries//:diesel",
        "@crates_libraries//:diesel_migrations",
        "@crates_libraries//:diesel_table_macro_syntax",
        "@crates_libraries//:diffy",
        "@crates_libraries//:dotenvy",
        "@crates_libraries//:fd-lock",
        "@crates_libraries//:heck",
        "@crates_libraries//:pq-sys",
        "@crates_libraries//:regex",
        "@crates_libraries//:serde",
        "@crates_libraries//:serde_regex",
        "@crates_libraries//:similar-asserts",
        "@crates_libraries//:syn",
        "@crates_libraries//:thiserror",
        "@crates_libraries//:toml",
        "@crates_libraries//:tracing",
        "@crates_libraries//:tracing-subscriber",
        "@crates_libraries//:url",
    ],
)

load("@aspect_rules_jest//jest:defs.bzl", "jest_test")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")

npm_link_all_packages(name = "node_modules")

ts_proto_library(
    name = "ts_proto",
    # The //examples package is the root pnpm package for the repo, so we
    # borrow from the proto/grpc example to provide the required
    # ts_proto_library npm dependencies.
    node_modules = ":node_modules",
    proto = "//sandbox/ts-library-with-tests/proto:bar_proto",
    proto_srcs = ["//sandbox/ts-library-with-tests/proto:bar.proto"],
    # This is disabled to avoid checking in the output files, which are
    # implicitly inputs for the copy_file tests.
    copy_files = False,
    tags = ["manual"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# ts_config(
#     name = "jest_config",
#     srcs = ["jest.config.js"],
# )

js_library(
    name = "jest_config",
    srcs = ["jest.config.js"],
    data = [
        "package.json",  # for type=module
    ],
)

ts_project(
    name = "src_ts",
    srcs = [
        "a.ts",
    ],
    data = [
        "package.json",  # for type=module
    ],
    declaration = True,
    # source_map = True,
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/node",
        ":ts_proto",
        # "//apps/finances/tauri/models/protos:protos_ts",
    ],
)

ts_project(
    name = "src_test_ts",
    srcs = [
        "a.test.ts",
        # "src-js/index.spec.ts",
    ],
    data = [
        "package.json",  # for type=module
    ],
    declaration = True,
    # source_map = True,
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@testing-library/jest-dom",
        ":node_modules/@types/jest",
        ":src_ts",
    ],
)

jest_test(
    name = "test",
    config = ":jest_config",
    data = [
        # ":node_modules/jest-environment-jsdom",
        ":src_test_ts",
        # "a.test.js",
        # "package.json",  # for type=module
    ],
    # entry_point = "a.test.js",
    node_modules = ":node_modules",
)

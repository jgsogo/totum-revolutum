load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@totum//bazel:defs.bzl", "run_copy_to_workspace")
load("@totum//bazel/rust:defs.bzl", "rust_library_tests_and_docs")
load("@totum//bazel/rust/diesel:defs.bzl", "diesel_print_schema", "diesel_setup")

# // Working with Diesel requires several targets to create and update the schemas (and an associated database
# // because these schemas are created from the database)

filegroup(
    name = "diesel_config",
    srcs = ["diesel.toml"],
)

filegroup(
    name = "migrations",
    srcs = glob(["migrations/**/*.sql"]),
)

diesel_setup(
    name = "setup",
    config_file = ":diesel_config",
    database_url = "db.sqlite3",
    migrations = [
        ":migrations",
    ],
)

diesel_print_schema(
    name = "schema",
    config_file = ":diesel_config",
    database_url = ":setup",
    schema = "src/schema.rs",
)

# We need to run this rule so we can build using Cargo
run_copy_to_workspace(
    name = "schema.update",
    origin = ":schema",
    tags = ["update"],
    target = "src/schema.rs",
)

rust_library_tests_and_docs(
    name = "finances_db",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    aliases = aliases(),
    all_features = {
        "test": [
            "test",
        ],
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    test_compile_data = [":migrations"],
    test_deps = [
        "@crates_libraries//:anyhow",
        "@crates_libraries//:diesel_migrations",
        "@crates_libraries//:tempfile",
    ],
    deps = all_crate_deps(
        normal = True,
    ),
)

rust_binary(
    name = "bin",
    srcs = glob(["src/bin/**/*.rs"]),
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":finances_db",
    ],
)

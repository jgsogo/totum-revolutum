load("@aspect_rules_js//js:defs.bzl", "js_run_binary", "js_run_devserver")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//bazel/tools/npm:@sveltejs/package/package_json.bzl", svelte_package_bin = "bin")

# load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//bazel/tools/npm:vite/package_json.bzl", vite_bin = "bin")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "src",
    srcs = glob(["src/**/*.*"]),
)

filegroup(
    name = "static",
    srcs = glob(["static/**/*.*"]),
)


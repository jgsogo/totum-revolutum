js_run_binary(
    name = "build",
    srcs = [
        # Configs
        "package.json",
        "postcss.config.cjs",
        "svelte.config.js",
        "tailwind.config.js",
        "tsconfig.json",
        "vite.config.js",

        # Build deps
        ":node_modules",  # TODO: Use //:node_modules instead
        "//apps/finances/tauri/models:models/ts",

        # Sources
        ":src",
        ":static",
    ],
    args = ["build --config vite.config.js"],
    chdir = package_name(),
    out_dirs = ["build"],
    tool = ":vite_binary",
    # visibility = ["//packages:__subpackages__"],
    visibility = ["//apps/finances/tauri/src-tauri:__pkg__"],
)

js_run_devserver(
    name = "devserver",
    args = ["dev --config vite.config.js"],
    chdir = package_name(),
    command = "./node_modules/.bin/vite",
    data = [
        # Configs
        "package.json",
        "postcss.config.cjs",
        "svelte.config.js",
        "tailwind.config.js",
        "tsconfig.json",
        "vite.config.js",

        # Build deps
        ":node_modules",  # TODO: Use //:node_modules instead
        "//apps/finances/tauri/models:models/ts",

        # Sources
        ":src",
        ":static",
    ],
    grant_sandbox_write_permissions = True,
    visibility = ["//apps/finances:__pkg__"],
)

load("@aspect_rules_js//js:defs.bzl", "js_run_devserver")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel/tauri:defs.bzl", "tauri_run")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "src",
    srcs = glob(["src/**/*.*"]),
)

filegroup(
    name = "static",
    srcs = glob(["static/**/*.*"]),
)

js_run_devserver(
    name = "devserver",
    args = ["dev --config vite.config.js"],
    chdir = package_name(),
    command = "./node_modules/.bin/vite",
    data = [
        # Configs
        "package.json",
        "postcss.config.cjs",
        "svelte.config.js",
        "tailwind.config.js",
        "tsconfig.json",
        "vite.config.js",

        # Build deps
        ":node_modules",  # TODO: Use //:node_modules instead
        "//apps/finances/tauri/models:models/ts",
        "//apps/finances/tauri/models/protos:protos_ts",

        # Sources
        ":src",
        ":static",
    ],
    grant_sandbox_write_permissions = True,
)

tauri_run(
    name = "dev",
    backend = "//apps/finances/tauri/src-tauri:app",
    frontend = ":devserver",
    visibility = ["//visibility:public"],
)

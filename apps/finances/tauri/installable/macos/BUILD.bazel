"""
We deploy this application in MacOS using a DMG:

> Credit: I'm following this script in the Widelands repo: https://github.com/widelands/widelands/blob/master/utils/macos/build_app.sh

 * create the package payload

   ```
    |-- Finances.app/Contents
    |                |-- Resources
    |                |   `-- finances.icns
    |                |-- MacOS
    |                |   `-- app
    |                `-- Info.plist
   ```

 * maybe use `codesign`
 * maybe use `strip`

More info about the Tauri bundle: https://v2.tauri.app/distribute/macos-application-bundle/

TODO: Create the DMG installable

"""

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel/tools/macos:dmg.bzl", "create_dmg")

pkg_tar(
    name = "contents",
    srcs = [
        "//apps/finances/tauri/installable/macos/contents:info-plist",
        "//apps/finances/tauri/installable/macos/contents/MacOS:app",
        "//apps/finances/tauri/installable/macos/contents/Resources:icns",
    ],
    # include_runfiles = True,
    tags = [
        "no-remote-cache",
    ],
)

create_dmg(
    name = "dmg",
    app_name = "Finances.app",
    contents = ":contents",
    tags = [
        "no-remote-cache",
        "no-sandbox",
    ],
)

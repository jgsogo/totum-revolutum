#     name = "protos_ts",
#     node_modules = ":node_modules",
#     proto = ":account_proto",
#     proto_srcs = ["protos/account.proto"],
# )

ts_project(
    name = "lib",
    srcs = [
        "src-js/hello-world.ts",
        "src-js/index.ts",
    ],
    declaration = True,
    out_dir = "dist",
    tsconfig = "tsconfig.json",
    visibility = ["//visibility:public"],
    deps = [
        "//apps/finances/tauri/protocol/protos:protos_ts",
        # ":node_modules/@aspect-test/e",
        # ":node_modules/@aspect-test/f",
        # ":node_modules/@types/node",
        # ":node_modules/alias-e",
    ],
)

# Exposed via js_library()
js_library(
    name = "pkg",
    srcs = [
        "package.json",
        ":lib",
    ],
    visibility = ["//visibility:public"],
)

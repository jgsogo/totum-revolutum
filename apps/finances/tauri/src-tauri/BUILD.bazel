rust_binary(
    name = "app",
    srcs = ["src/main.rs"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    visibility = [
        "//apps/finances:__subpackages__",
    ],
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":applib",
    ],
)

        "//libraries/finances/accounts/rust:finances_accounts/test_utils",
        "@crates_libraries//:serde_json",
        "@crates_libraries//:tauri",
    ],
)

expand_template(
    name = "expose_postgresql",
    out = "expose_postgresql.yaml",
    tags = [
        "manual",
    ],
    template = [
        "services:",
        "  db:",
        "    ports:",
        "      - 5432",
        "",
    ],
)

with_docker_compose_test(
    name = "integration_tests",
    binaries = [
        "_integration_tests_tests/test_command_account_details",  # NOTE: The rust_test_suite is just a group of tests!
    ],
    docker_compose = [
        "//apps/finances/django:app-docker_compose",  # FIXME: Are docker images a transitive dep? Do I need to load them first?
        ":expose_postgresql",
    ],
    docker_services = [
        "db",
        "web",
    ],
    env = {
        "SQL_ENGINE": "django.db.backends.postgresql",
        "SECRET_KEY": "testing-app",
        "SQL_DATABASE": "finances_tauri_tests",
    },
    # env_transpose = {

# Unittests
rust_test(
    name = "tests",
    crate = ":applib",
    crate_features = [
        "postgres",
    ],
    data = [
        "tauri.conf.json",
    ] + glob(["icons/**"]) + glob(["capabilities/**"]),
)

# Integration tests
rust_test_suite(
    name = "_integration_tests",
    # srcs = glob(["tests/**/test_*.rs"]),
    srcs = [
        # "tests/test_wip.rs",
        "tests/test_command_account_details.rs",
    ],
    crate_features = ["postgres"],
    # data = glob(["tests/common/**/*.rs"]) + [

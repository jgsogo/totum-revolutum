load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@crates_libraries//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rust_test_suite")
load("//bazel/containers/with_docker:with_docker_compose_run.bzl", "with_docker_compose_test")

cargo_build_script(
    name = "build",
    srcs = ["build.rs"],
    build_script_env = {
        "DEP_TAURI_DEV": "false",
    },
    data = [
        "Cargo.toml",
        "tauri.conf.json",
    ] + glob(["src/**/*.rs"]),
    deps = [
        "@crates_libraries//:tauri-build",
    ],
)

rust_library(
    name = "applib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_features = ["postgres"],
    crate_name = "finances_app_lib",
    data = [
        "tauri.conf.json",
    ] + glob(["icons/**"]) + glob(["capabilities/**"]),
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":build",
        "//libraries/finances/accounts/rust:finances_accounts",
        "//libraries/finances/investments/rust:finances_investments",
    ],
)


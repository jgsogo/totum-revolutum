load("@aspect_rules_jest//jest:defs.bzl", "jest_test")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")

load("@crates_libraries//:defs.bzl", "all_crate_deps")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

npm_link_all_packages(name = "node_modules")

###########
# Rust library
###########

rust_library(
    name = "models/rust",
    srcs = glob(
        ["src-rust/**/*.rs"],
    ),
    crate_features = ["bazel"],
    crate_name = "finances_app_models",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//apps/finances/tauri/models/protos:protos_rs",
    ],
)

# Unittests
rust_test(
    name = "tests",
    crate = ":models/rust",
    crate_features = ["bazel"],
)

###########
# Javascript library
###########

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//apps/finances/tauri/models:__subpackages__"],
)

js_library(
    name = "jest_config",
    srcs = ["jest.config.js"],
)

ts_project(
    name = "src_ts",
    srcs = glob(
        ["src-js/**/*.ts"],
        exclude = ["**/*.spec.ts", "**/*.test.ts"],
    ),
    declaration = True,
    source_map = True,
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@types/node",
        "//apps/finances/tauri/models/protos:protos_ts",
    ],
    visibility = ["//visibility:public"]
)

ts_project(
    name = "src_test_ts",
    srcs = glob([
        "src-js/**/*.spec.ts",
        "src-js/**/*.test.ts",
    ]),
    declaration = True,
    source_map = True,
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@testing-library/jest-dom",
        ":node_modules/@types/jest",
        ":src_ts",
    ],
)

jest_test(
    name = "test",
    config = ":jest_config",
    data = [
        ":node_modules/jest-environment-jsdom",
        ":src_test_ts",
    ],
    node_modules = ":node_modules",
)


load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@py_deps//:requirements.bzl", "requirement")

filegroup(
    name = "fixtures",
    srcs = glob(["fixtures/**/*.json"]),
)

filegroup(
    name = "static",
    srcs = glob(["static/**/*.py"]),
)

filegroup(
    name = "templates",
    srcs = glob(["templates/**/*.html"]),
)

py_library(
    name = "finances_data",
    srcs = glob(["**/*.py"]),
    data = [
        ":fixtures",
        ":static",
        ":templates",
    ],
    imports = ["../"],
    visibility = ["//apps/finances/django:__subpackages__"],
    deps = [
        requirement("django"),
        requirement("django-treenode"),
        requirement("django-money"),
        requirement("django-countries"),
    ],
)

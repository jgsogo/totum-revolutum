load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//apps/finances/django/installable:defs.bzl", "BIN_FOLDER")

pkg_tar(
    name = "app-admin-tar",
    srcs = [
        "//apps/finances/django:app-admin",
    ],
    include_runfiles = True,
    mode = "0551",
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

pkg_tar(
    name = "app-gunicorn-tar",
    srcs = [
        "//apps/finances/django:app-gunicorn",
    ],
    include_runfiles = True,
    mode = "0551",
    tags = [
        "manual",
        "no-remote-cache",
    ],
)

pkg_files(
    name = "bin",
    srcs = [
        ":app-admin-tar",
        ":app-gunicorn-tar",
        "//tools/envsubst",
    ],
    # We should include here the actual targets, but then they don't
    # include duplicated runfiles https://github.com/bazelbuild/rules_pkg/issues/902

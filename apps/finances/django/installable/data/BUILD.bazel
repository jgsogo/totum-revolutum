load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "pkg_mklink")
load("//apps/finances/django/installable:defs.bzl", "DATA_FOLDER", "NAME", "SUBSTITUTIONS")

expand_template(
    name = "supervisor_ini-file",
    out = "supervisord.ini",
    substitutions = SUBSTITUTIONS,
    tags = [
        "manual",
    ],
    template = "//bazel/python/django/deployment:supervisord.tpl.ini",
)

expand_template(
    name = "nginx_conf-file",
    out = "nginx.conf",
    substitutions = SUBSTITUTIONS,
    tags = [
        "manual",
    ],
    template = "//bazel/python/django/deployment:nginx.tpl.conf",
)

expand_template(
    name = "env-file",
    out = "envfile",
    substitutions = SUBSTITUTIONS,
    tags = [
        "manual",
    ],
    template = "//bazel/python/django/deployment:.env.tpl",
)

pkg_files(
    name = "data-files",
    srcs = [
        ":env-file",
        ":nginx_conf-file",
        ":supervisor_ini-file",
    ],
    attributes = pkg_attributes(
        group = "admin",
        mode = "0555",
        owner = "root",
    ),
    prefix = DATA_FOLDER,
)


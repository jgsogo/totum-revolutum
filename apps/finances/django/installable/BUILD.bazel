"""
We deploy this application in MacOS using a PKG:

 * create the package payload

   ```
    finances-pkg/
    │── payload/
    │   ├── usr/local/finances/
    │   │   ├── finances-django-admin
    │   │   ├── finances-django-gunicorn
    │   │   ├── envsubst
    │   │   ├── .env
    │   │   ├── data/
    │   │       ├── supervisor.d/finances.ini
    │   │       ├── nginx/finances.conf
    │   ├── usr/local/etc/
    │   │   ├── supervisor.d/
    │   │   |   ├── finances.ini
    │   ├   ├── nginx/servers/
    │   │       ├── finances.conf
    │   ├── usr/local/var/log/              # Path to store logs
    │   ├── usr/local/var/run/              # PIDs and sockets
    │── scripts/
    │   ├── preinstall            # ✅ NEW: Pre-install checks
    │   ├── postinstall           # Runs setup after installation
    │── finances.pkg
   ```

 * use `pkgbuild` to build the MacOS PKG

   ```sh
   pkgbuild --root payload
        --identifier com.totum-revolutum.finances
        --version 1.0
        --scripts scripts
        finances.pkg
   ```

 * it should be installable using

   ```sh
   sudo installer -pkg finances.pkg -target /
   ```

After installation, you check installed packages with

```
pkgutil --pkgs
```

and remove them with

 * list all files with `pkgutil --files <package name>`
 * remove the files and folders manually (be careful not to remove directories that contain other files)

"""

load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_mkdirs")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//apps/finances/django/installable:defs.bzl", "LOGS_FOLDER", "RUN_FOLDER")
load("//bazel/tools/pkgbuild:pkgbuild.bzl", "pkgbuild")

pkg_mkdirs(
    name = "dirs",
    attributes = pkg_attributes(
        group = "root",
        mode = "0755",
        owner = "root",
    ),
    dirs = [
        LOGS_FOLDER,
        RUN_FOLDER,
    ],
)

pkg_tar(
    name = "payload",
    srcs = [
        ":dirs",
        "//apps/finances/django/installable/bin",
        "//apps/finances/django/installable/data",
    ],
    include_runfiles = True,
    tags = [
        "no-remote-cache",
    ],
)

pkg_tar(
    name = "scripts",
    srcs = [
        "//apps/finances/django/installable/scripts",
    ],
    include_runfiles = True,
    tags = [
        "no-remote-cache",
    ],
)

pkgbuild(
    name = "installable",
    identifier = "com.totum-revolutum.finances",
    root = ":payload",
    scripts = ":scripts",
    tags = [
        "no-remote-cache",
    ],
    version = "0.0.0",
)

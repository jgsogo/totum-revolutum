load("//apps/finances/django/installable:defs.bzl", "ALL_FOLDERS")
load("//bazel/tools/pkgbuild:apply_envsubst.bzl", "apply_envsubst")
load("//bazel/tools/pkgbuild:combine_envfiles.bzl", "combine_envfiles")
load("//bazel/tools/pkgbuild:scripts.bzl", "postinstall")
load("//bazel/tools/pkgbuild:untar_files.bzl", "untar_files")

apply_envsubst(
    name = "envsubst-supervisor",
    files = [
        "/usr/local/finances/data/supervisord.ini",
        "/usr/local/finances/data/nginx.conf",
        "/usr/local/finances/data/envfile",
        # DATA_FOLDER + "/supervisord.ini",
    ],
)

untar_files(
    name = "untar-files",
    files = [
        "/usr/local/finances/bin/app-admin-tar.tar",
        "/usr/local/finances/bin/app-gunicorn-tar.tar",
        # BIN_FOLDER + "/app-admin-tar.tar",  # "location :app-admin-tar"
        # BIN_FOLDER + "/app-gunicorn-tar.tar",  # "location :app-gunicorn-tar"
    ],
)

combine_envfiles(
    name = "combine-env",
    source = "/usr/local/finances/data/envfile",
    target = "/usr/local/finances/bin/.env",
)

postinstall(
    name = "postinstall",
    chunks = [
        ":envsubst-supervisor",
        ":untar-files",
        ":combine-env",
    ],
    folders = ALL_FOLDERS,
    pkgbuild_name = "finances",
    tags = ["manual"],
    visibility = ["//apps/finances/django/installable/scripts:__subpackages__"],
)

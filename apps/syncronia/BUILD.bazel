load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@totum//bazel/rust:defs.bzl", "rust_library_tests_and_docs")
load("@totum//bazel/rust/docs:defs.bzl", "rust_docs")
load("//bazel:value_from_stable_status.bzl", "value_from_stable_status")

value_from_stable_status(
    name = "version",
    default = "totum-revolutum",
    key = "STABLE_SYNCRONIA_VERSION",
    visibility = [":__subpackages__"],
)

rust_library_tests_and_docs(
    name = "syncronia_lib",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    all_features = {
        "cli": ["cli"],
        "test_utils": ["test_utils"],
    },
    crate_name = "syncronia",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        "@totum//libraries/cron",
        "@totum//libraries/filesystem",
        "@totum//libraries/pcloud_sdk",
    ],
)

rust_binary(
    name = "syncronia",
    srcs = glob(["src/cli/**/*.rs"]),
    crate_features = [
        "cli",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":syncronia_lib",
        "@totum//libraries/cron",
        "@totum//libraries/filesystem",
        "@totum//libraries/pcloud_sdk",
    ],
)

rust_docs(
    name = "docs",
    crates = [
        ":syncronia",
        ":syncronia_lib",
    ],
    visibility = ["//docs:__subpackages__"],
)

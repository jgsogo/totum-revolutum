load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

ALL_PROTOS = [
    "actions.proto",
    "board.proto",
    "cards.proto",
    "decks.proto",
    "event_log.proto",
    "game.proto",
    "player.proto",
]

proto_library(
    name = "models_proto",
    srcs = ALL_PROTOS,
    deps = [
        "//apps/board_games/games/ticket_to_ride/maps:map_proto",
    ],
)

cc_proto_library(
    name = "models_cc_proto",
    visibility = ["//apps/board_games/games/ticket_to_ride:__subpackages__"],
    deps = [":models_proto"],
)

ts_proto_library(
    name = "models_ts_proto",
    copy_files = True,
    node_modules = "//:node_modules",
    proto = ":models_proto",
    proto_srcs = ALL_PROTOS,
    protoc_gen_options = {
        "import_extension": "js",
    },
    visibility = [
        "//apps/board_games/games/ticket_to_ride/webapp:__pkg__",
    ],
)

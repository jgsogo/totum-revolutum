load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

filegroup(
    name = "map_proto_file",
    srcs = ["map.proto"],
    visibility = ["//apps/board_games/games/ticket_to_ride/maps/usa:__pkg__"],
)

proto_library(
    name = "map_proto",
    srcs = [
        "map.proto",
    ],
    visibility = ["//apps/board_games/games/ticket_to_ride/models:__pkg__"],
)

cc_proto_library(
    name = "map_cc_proto",
    visibility = ["//apps/board_games/games/ticket_to_ride:__subpackages__"],
    deps = [":map_proto"],
)

ts_proto_library(
    name = "maps_ts_proto",
    copy_files = True,
    node_modules = "//:node_modules",
    proto = ":map_proto",
    proto_srcs = [
        "map.proto",
    ],
    protoc_gen_options = {
        "import_extension": "js",
    },
    # visibility = [
    #     "//apps/board_games/games/ticket_to_ride/webapp:__pkg__",
    # ],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//apps/board_games/games/ticket_to_ride:__subpackages__"],
)

ts_project(
    name = "maps-js",
    srcs = glob(
        ["js/**/*.ts"],
        exclude = [
            "js/**/*.spec.ts",
            "js/**/*.test.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    source_map = True,
    tsconfig = ":tsconfig",
    visibility = ["//apps/board_games/webapp:__subpackages__"],
    deps = [
        ":maps_ts_proto",
        "//:node_modules/@types/node",
        "//:node_modules/buffer",
    ],
)

# Testing JS library
ts_project(
    name = "src_test_ts",
    srcs = glob([
        "js/**/*.spec.ts",
        # "src-js/**/*.test.ts",
    ]) + ["package.json"],
    declaration = True,
    source_map = True,
    tsconfig = ":tsconfig",
    deps = [
        ":maps-js",
        "//:node_modules/vitest",
        "//apps/board_games/games/ticket_to_ride/maps/usa:usa-js",
    ],
)

vitest_bin.vitest_test(
    name = "test.vitest",
    args = ["run"],
    chdir = package_name(),
    data = [
        "package.json",
        ":src_test_ts",
        "//:node_modules",  # TODO: Consume only the required deps
    ],
)

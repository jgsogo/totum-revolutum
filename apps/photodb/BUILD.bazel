load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:run_copy_to_workspace.bzl", "run_copy_to_workspace")
load("//bazel:value_from_stable_status.bzl", "value_from_stable_status")
load("//bazel/rust:defs.bzl", "rust_library_tests_and_docs")
load("//bazel/rust/diesel:defs.bzl", "diesel_print_schema", "diesel_setup")

value_from_stable_status(
    name = "version",
    default = module_name(),
    key = "STABLE_PHOTODB_VERSION",
    visibility = [":__subpackages__"],
)

# // Working with Diesel requires several targets to create and update the schemas (and an associated database
# // because these schemas are created from the database)

filegroup(
    name = "diesel_config",
    srcs = ["diesel.toml"],
)

filegroup(
    name = "migrations",
    srcs = glob(["migrations/**/*.sql"]),
)

diesel_setup(
    name = "setup",
    config_file = ":diesel_config",
    database_url = "db.sqlite3",
    migrations = [
        "//libraries/filesystem:migrations",
        ":migrations",
    ],
)

diesel_print_schema(
    name = "schema",
    config_file = ":diesel_config",
    database_url = ":setup",
    schema = "src/database/schema.rs",
)

# We need to run this rule so we can build using Cargo
run_copy_to_workspace(
    name = "schema.update",
    origin = ":schema",
    tags = ["update"],
    target = "src/database/schema.rs",
)

rust_library_tests_and_docs(
    name = "photodb_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/database/schema.rs"],
    ) + [":schema"],  # Include the autogenerated one, exclude the one inside the repo
    aliases = aliases(),
    compile_data = [":migrations"],
    crate_name = "photodb",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//libraries/diesel_utils",
        "//libraries/filesystem",
        "//libraries/pcloud_sdk",
        "//libraries/utils",
    ],
)

rust_binary(
    name = "photodb",
    srcs = ["src/bin/photodb.rs"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":photodb_lib",
        "//libraries/filesystem",
        "//libraries/pcloud_sdk",
        "//libraries/utils",
    ],
)

load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc", "rust_doc_test", "rust_library", "rust_test")
load("//bazel:value_from_stable_status.bzl", "value_from_stable_status")
load("//bazel/rust/diesel:diesel_print_schema.bzl", "diesel_print_schema")
load("//bazel/rust/diesel:diesel_setup.bzl", "diesel_setup")

value_from_stable_status(
    name = "version",
    default = module_name(),
    key = "STABLE_PHOTODB_VERSION",
    visibility = [":__subpackages__"],
)

# // Working with Diesel requires several targets to create and update the schemas (and an associated database
# // because these schemas are created from the database)

filegroup(
    name = "diesel_config",
    srcs = ["diesel.toml"],
)

filegroup(
    name = "migrations",
    srcs = glob(["migrations/**/*.sql"]),
)

diesel_setup(
    name = "setup",
    config_file = ":diesel_config",
    database_url = "db.sqlite3",
    migrations = [
        "//libraries/filesystem:migrations",
        ":migrations",
    ],
)

diesel_print_schema(
    name = "schema",
    config_file = ":diesel_config",
    database_url = ":setup",
    target = "src/database/schema.rs",
)

rust_library(
    name = "photodb_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/bin/photodb.rs",
        ],
    ),
    aliases = aliases(),
    compile_data = [":migrations"],
    crate_name = "photodb",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    # FIXME: This additional envvar should not be needed.
    # rustc_env = {"CARGO_MANIFEST_DIR": "$${pwd}/bazel-out/darwin_x86_64-fastbuild/bin/apps/photodb/"},
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//libraries/diesel_utils",
        "//libraries/filesystem",
        "//libraries/pcloud_sdk",
        "//libraries/utils",
    ],
)

rust_test(
    name = "tests",
    crate = ":photodb_lib",
)

rust_doc(
    name = "doc",
    crate = ":photodb_lib",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc/tests",
    crate = ":photodb_lib",
)

rust_binary(
    name = "photodb",
    srcs = ["src/bin/photodb.rs"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":photodb_lib",
        "//libraries/filesystem",
        "//libraries/pcloud_sdk",
        "//libraries/utils",
    ],
)

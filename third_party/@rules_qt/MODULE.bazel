module(
    name = "rules_qt",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.8")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

bazel_dep(name = "aspect_rules_py", version = "1.6.3", dev_dependency = True)
bazel_dep(name = "rules_uv", version = "0.88.0", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.21.2", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "rules_multirun", version = "0.13.0", dev_dependency = True)

PYTHON_VERSION = "3.13"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "py_deps_rules_qt",
    python_version = PYTHON_VERSION,
    requirements_lock = "@rules_qt//tools:requirements.lock",
)
use_repo(pip, "py_deps_rules_qt")

qt = use_extension("@rules_qt//:extensions.bzl", "qt")
use_repo(qt, "qt_mac_clang_64")

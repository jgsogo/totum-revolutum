load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test", "rust_test_suite")
load("//bazel/rust/diesel:diesel_print_schema.bzl", "diesel_print_schema")
load("//bazel/rust/diesel:diesel_setup.bzl", "diesel_setup")

rust_library(
    name = "diesel_utils",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["sqlite"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ),
)

rust_test(
    name = "tests",
    crate = ":diesel_utils",
    crate_features = ["sqlite"],
)

rust_test_suite(
    name = "integration_tests",
    srcs = glob(["tests/**/test_*.rs"]),
    compile_data = [":migrations"],
    crate_features = ["sqlite"],
    shared_srcs = glob(
        ["tests/common/**/*.rs"],
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":diesel_utils",
        "@crates_libraries//:diesel_migrations",
        "@crates_libraries//:testing_logger",
    ],
)

rust_doc(
    name = "doc",
    crate = ":diesel_utils",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc/tests",
    crate = ":diesel_utils",
)

# Create the schema.rs file for integration tests
filegroup(
    name = "diesel_config",
    srcs = ["tests/common/diesel.toml"],
)

filegroup(
    name = "migrations",
    srcs = glob(["tests/common/migrations/**/*.sql"]),
)

diesel_setup(
    name = "setup",
    config_file = ":diesel_config",
    database_url = "db.sqlite3",
    migrations = [":migrations"],
)

diesel_print_schema(
    name = "schema",
    config_file = ":diesel_config",
    database_url = ":setup",
    target = "tests/common/schema.rs",
)

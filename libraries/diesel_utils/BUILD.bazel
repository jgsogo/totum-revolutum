load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("//bazel:run_copy_to_workspace.bzl", "run_copy_to_workspace")
load("//bazel/rust:defs.bzl", "rust_library_tests_and_docs")
load("//bazel/rust/diesel:defs.bzl", "diesel_print_schema", "diesel_setup")

rust_library_tests_and_docs(
    name = "diesel_utils",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    all_features = {
        "sqlite": [
            "sqlite",
        ],
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    test_data = glob(
        ["tests/common/**/*.rs"],
        # exclude = ["tests/common/schema.rs"],  # FIXME: I should exclude the one in the repo in favor of the autogenerated one
    ) + glob([
        "tests/common/migrations/**",
    ]) + [":schema"],  # Include the autogenerated one (the one inside the repo was excluded)
    test_suite_deps = [
        "@crates_libraries//:diesel_migrations",
        "@crates_libraries//:testing_logger",
    ],
    deps = all_crate_deps(
        normal = True,
    ),
)

# Create the schema.rs file for integration tests
filegroup(
    name = "diesel_config",
    srcs = ["tests/common/diesel.toml"],
)

filegroup(
    name = "migrations",
    srcs = glob(["tests/common/migrations/**/*.sql"]),
)

diesel_setup(
    name = "setup",
    config_file = ":diesel_config",
    database_url = "db.sqlite3",
    migrations = [":migrations"],
)

diesel_print_schema(
    name = "schema",
    config_file = ":diesel_config",
    database_url = ":setup",
    schema = "tests/common/schema.rs",
)

# We need to run this rule so we can build using Cargo
run_copy_to_workspace(
    name = "schema.update",
    origin = ":schema",
    tags = ["update"],
    target = "tests/common/schema.rs",
)

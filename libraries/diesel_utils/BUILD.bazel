rust_library(
    name = "diesel_utils",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["sqlite"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    rustc_flags = [
        "-A",
        "dead_code",
    ],  # Allow dead_code for vanilla libraries (no features enabled)
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ),
)

# Unittests
rust_test(
    name = "tests",
    crate = ":diesel_utils",
    crate_features = ["sqlite"],
)

# Integration tests
rust_test_suite(
    name = "integration_tests",
    srcs = glob(["tests/**/test_*.rs"]),
    compile_data = glob([
        "tests/common/migrations/**",
    ]),
    crate_features = ["sqlite"],
    shared_srcs = glob(
        ["tests/common/**/*.rs"],
        exclude = ["tests/common/schema.rs"],  # FIXME: I should exclude the one in the repo in favor of the autogenerated one
    ) + [":schema"],  # Include the autogenerated one (the one inside the repo was excluded)
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":diesel_utils",
        "@crates_libraries//:diesel_migrations",
        "@crates_libraries//:testing_logger",
    ],
)

# Documentation
rust_doc(
    name = "doc",
    crate = ":diesel_utils",
    visibility = ["//visibility:public"],
)

# Documentation - tests
rust_doc_test(
    name = "doc/tests",
    crate = ":diesel_utils",
)

# Create the schema.rs file for integration tests
filegroup(
    name = "diesel_config",
    srcs = ["tests/common/diesel.toml"],
)

filegroup(
    name = "migrations",
    srcs = glob(["tests/common/migrations/**/*.sql"]),
)

diesel_setup(
    name = "setup",
    config_file = ":diesel_config",
    database_url = "db.sqlite3",
    migrations = [":migrations"],
)

diesel_print_schema(
    name = "schema",
    config_file = ":diesel_config",
    database_url = ":setup",
    schema = "tests/common/schema.rs",
)

# We need to run this rule so we can build using Cargo
run_copy_to_workspace(
    name = "schema.update",
    origin = ":schema",
    tags = ["update"],
    target = "tests/common/schema.rs",
)

load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/containers/postgres:with_postgres_run.bzl", "with_postgres_test")

cc_test(
    name = "_tests",
    srcs = [
        "test_unique_db_connection_pool.cpp",
        "test_unique_db_connection_pool_with_prefix.cpp",
    ],
    tags = ["manual"],
    deps = [
        "//libraries/utils/cpp/db/catch2:unique_db_connection_pool",
        "@catch2//:catch2_main",
    ],
)

with_postgres_test(
    name = "tests",
    binaries = [
        "//bazel/containers/postgres:example_users_table",
        ":_tests",
    ],
    env_transpose = {
        # Envvars for the 'with_prefix' test
        "RANDOMPREFIX_SQL_DATABASE": "POSTGRES_DB",
        "RANDOMPREFIX_SQL_USER": "POSTGRES_USER",
        "RANDOMPREFIX_SQL_PASSWORD": "POSTGRES_PASSWORD",
        "RANDOMPREFIX_SQL_HOST": "POSTGRES_HOST",
        "RANDOMPREFIX_SQL_PORT": "POSTGRES_PORT",
    },
)

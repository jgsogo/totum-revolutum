load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "utils",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "filesystem",
        "async",
        "http",
        "dates",
    ],
    proc_macro_deps = [
        "//bazel/third_party/crates:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel/third_party/crates:camino",
        "//bazel/third_party/crates:headers",
        "//bazel/third_party/crates:lazy_static",
        "//bazel/third_party/crates:log",
        "//bazel/third_party/crates:regex",
        "//bazel/third_party/crates:reqwest",
        "//bazel/third_party/crates:serde",
        "//bazel/third_party/crates:serde_json",
        "//bazel/third_party/crates:thiserror",
        "//bazel/third_party/crates:tokio",
        "//bazel/third_party/crates:tracing",
    ],
)

rust_test(
    name = "tests",
    crate = ":utils",
    crate_features = [
        "filesystem",
        "async",
        "http",
        "dates",
    ],
    deps = [
        "//bazel/third_party/crates:anyhow",
        "//bazel/third_party/crates:testing_logger",
    ],
)

rust_doc(
    name = "doc",
    crate = ":utils",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc/tests",
    crate = ":utils",
)

"""
A module to generate the fixtures that contain the base information of the
'finances/accounts' application. This data is ALWAYS available after
creating the database and applying the migrations.

The source of truth for the content in these fixtures are the migrations of
the Django application.
"""

load("//bazel:sh_with_runfiles_binary.bzl", "sh_with_runfiles_binary")
load("//bazel/containers/with_docker:with_postgres_run.bzl", "with_postgres_run")

MODELS = [
    "accounttype",
    "movementtype",
]

[
    sh_with_runfiles_binary(
        name = "_gen_fixture_{}".format(it),
        args = [
            "dumpdata",
            "finances_accounts.{}".format(it),
            "--format",
            "yaml",
            "--output",
            "$$BUILD_WORKSPACE_DIRECTORY/" + package_name() + "/{}.yaml".format(it),
        ],
        tool = "//libraries/finances/accounts/django_finances_accounts:django-admin",
    )
    for it in MODELS
]

with_postgres_run(
    name = "genfixtures",
    # First migrate, then generate the fixtures
    binaries = [
        "//libraries/finances/accounts/django_finances_accounts:migrate",
    ] + [":_gen_fixture_{}".format(it) for it in MODELS],
    env = {
        "DJANGO_SQL_ENGINE": "django.db.backends.postgresql",
    },
    env_transpose = {
        "DJANGO_SQL_DATABASE": "POSTGRES_DB",
        "DJANGO_SQL_USER": "POSTGRES_USER",
        "DJANGO_SQL_PASSWORD": "POSTGRES_PASSWORD",
        "DJANGO_SQL_HOST": "POSTGRES_HOST",
        "DJANGO_SQL_PORT": "POSTGRES_PORT",
    },
    tags = [
        "update",
    ],
)

filegroup(
    name = "fixtures",
    srcs = ["{}.yaml".format(it) for it in MODELS],
    visibility = ["//visibility:public"],
)

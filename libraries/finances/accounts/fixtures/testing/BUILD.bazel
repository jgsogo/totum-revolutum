"""
The fixtures in this module are only intended for TESTING. They are generated from
the data populated by the Django 'finances_accounts_test_data' command.
"""

load("//bazel:sh_with_runfiles_binary.bzl", "sh_with_runfiles_binary")
load("//bazel/containers/with_docker:with_postgres_run.bzl", "with_postgres_run")

MODELS_FOR_TESTING = [
    "account",
    "accountholder",
    "accountholderrole",
    "custodian",
    "fx",
    "movement",
    "snapshot",
    "transaction",
    "transactiongroup",
]

[
    sh_with_runfiles_binary(
        name = "_gen_fixture_{}".format(it),
        args = [
            "dumpdata",
            "finances_accounts.{}".format(it),
            "--format",
            "yaml",
            "--output",
            "$$BUILD_WORKSPACE_DIRECTORY/" + package_name() + "/{}.yaml".format(it),
        ],
        tool = "//libraries/finances/accounts/django_finances_accounts:django-admin",
    )
    for it in MODELS_FOR_TESTING
]

with_postgres_run(
    name = "genfixtures",
    # First migrate, then populate the database
    binaries = [
        "//libraries/finances/accounts/django_finances_accounts:migrate",
        "//libraries/finances/accounts/django_finances_accounts:populate_test_database",
    ] + [":_gen_fixture_{}".format(it) for it in MODELS_FOR_TESTING],
    env = {
        "DJANGO_SQL_ENGINE": "django.db.backends.postgresql",
    },
    env_transpose = {
        "DJANGO_SQL_DATABASE": "POSTGRES_DB",
        "DJANGO_SQL_USER": "POSTGRES_USER",
        "DJANGO_SQL_PASSWORD": "POSTGRES_PASSWORD",
        "DJANGO_SQL_HOST": "POSTGRES_HOST",
        "DJANGO_SQL_PORT": "POSTGRES_PORT",
    },
    tags = [
        "update",
    ],
)

filegroup(
    name = "fixtures",
    srcs = ["{}.yaml".format(it) for it in MODELS_FOR_TESTING],
    visibility = ["//visibility:public"],
)

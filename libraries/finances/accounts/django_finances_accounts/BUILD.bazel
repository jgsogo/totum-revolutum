load("@py_deps//:requirements.bzl", "requirement")
load("//bazel/containers/with_docker:with_postgres_run.bzl", "with_postgres_run")
load("//bazel/python/django/app:django_app.bzl", "django_app")
load("//bazel/rust/diesel:print_schema.bzl", "diesel_print_schema")

django_app(
    name = "finances_accounts",
    visibility = ["//visibility:public"],
    deps = [
        requirement("django-treenode"),
        requirement("django-money"),
        requirement("django-countries"),
        requirement("django-appconf"),
    ],
)


load("@py_deps//:requirements.bzl", "requirement")
load("//bazel:sh_with_runfiles_binary.bzl", "sh_with_runfiles_binary")
load("//bazel/python/django/app:django_app.bzl", "django_app")

django_app(
    name = "finances_accounts",
    visibility = ["//visibility:public"],
    deps = [
        requirement("django-treenode"),
        requirement("django-money"),
        requirement("django-countries"),
        requirement("django-appconf"),
        requirement("pyyaml"),
    ],
)

# TODO: If we consume the //libraries/finances/accounts/fixtures/testing, we
#       can remove this command to populate the DB with test data.
#
#       For these models, the fixtures are not that complex/long so I think we
#       can use them instead of the Python script to populate test data.
sh_with_runfiles_binary(
    name = "populate_test_database",
    args = [
        "finances_accounts_test_data",
    ],
    tags = ["manual"],
    tool = ":django-admin",
    visibility = ["//libraries/finances/accounts/fixtures/testing:__pkg__"],
)

load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@py_deps//:requirements.bzl", "requirement")

filegroup(
    name = "fixtures",
    srcs = glob(["fixtures/**/*.json"]),
)

filegroup(
    name = "static",
    srcs = glob(["static/**/*.py"]),
)

filegroup(
    name = "templates",
    srcs = glob(["templates/**/*.html"]),
)

py_library(
    name = "finances_data",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            "tests/**/*.*",
            "run_local.py",
        ],  # Test files are not part of the library
    ),
    data = [
        ":fixtures",
        ":static",
        ":templates",
    ],
    imports = ["../"],
    visibility = ["//apps/finances/django:__subpackages__"],
    deps = [
        requirement("django"),
        requirement("django-treenode"),
        requirement("django-money"),
        requirement("django-countries"),
        requirement("django-appconf"),
    ],
)

py_binary(
    name = "unittests",
    srcs = glob(["tests/**/*.py"]) + ["run_local.py"],  # Include the test files here
    args = [
        "test",
        "tests",
    ],
    imports = ["."],
    main = "run_local.py",
    deps = [
        ":finances_data",
    ],
)

py_binary(
    name = "makemigrations",
    srcs = glob(["tests/**/*.py"]) + ["run_local.py"],  # Include the test files here
    args = [
        "makemigrations",
        "finances_accounts",
    ],
    imports = ["."],
    main = "run_local.py",
    deps = [
        ":finances_data",
    ],
    # TODO: Create a 'update' rule to copy the generated migration into the workspace
)


diesel_print_schema(
    name = "diesel_print_schema",
    schema = "src/schema.postgres.rs",
)

with_postgres_run(
    name = "diesel_schema_postgres",
    # First migrate,then print the schema
    binaries = [
        ":migrate",
        ":diesel_print_schema",
    ],
    env = {
        "SQL_ENGINE": "django.db.backends.postgresql",
    },
    env_transpose = {
        "SQL_DATABASE": "POSTGRES_DB",
        "SQL_USER": "POSTGRES_USER",
        "SQL_PASSWORD": "POSTGRES_PASSWORD",
        "SQL_HOST": "POSTGRES_HOST",
        "SQL_PORT": "POSTGRES_PORT",
    },
    postgres_image_tag = "17",
)


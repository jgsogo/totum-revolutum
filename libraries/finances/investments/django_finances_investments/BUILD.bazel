load("//bazel:sh_with_runfiles_binary.bzl", "sh_with_runfiles_binary")
load("//bazel/python/django/app:django_app.bzl", "django_app")

django_app(
    name = "finances_investments",
    visibility = ["//visibility:public"],
    deps = [
        "//libraries/finances/accounts/django_finances_accounts:finances_accounts",
    ],
)


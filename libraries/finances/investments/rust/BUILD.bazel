load("@crates_libraries//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:sh_with_runfiles_binary.bzl", "sh_with_runfiles_binary")
load("//bazel/containers/with_docker:with_postgres_run.bzl", "with_postgres_run", "with_postgres_test")

rust_library(
    name = "finances_investments",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["postgres"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    visibility = ["//apps/finances:__subpackages__"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//libraries/finances/accounts/rust:finances_accounts",
    ],
)

rust_library(
    name = "finances_investments/test_utils",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "postgres",
        "test_utils",
    ],
    crate_name = "finances_investments",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    visibility = ["//apps/finances:__subpackages__"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//libraries/finances/accounts/rust:finances_accounts/test_utils",
    ],
)

# Unittests... marked as 'manual' because they require Postgres
rust_test(
    name = "_tests",
    crate = ":finances_investments/test_utils",
    crate_features = [
        "postgres",
        "test_utils",
    ],
    tags = ["manual"],
    deps = [
        "@crates_libraries//:anyhow",
        "@crates_libraries//:tempfile",
    ],
)

with_postgres_test(
    name = "tests-postgres",
    # First migrate,then run the tests
    binaries = [
        "//libraries/finances/investments/django_finances_investments:migrate",
        ":_tests",
    ],
    env = {
        "SQL_ENGINE": "django.db.backends.postgresql",
    },
    env_transpose = {
        "SQL_DATABASE": "POSTGRES_DB",
        "SQL_USER": "POSTGRES_USER",
        "SQL_PASSWORD": "POSTGRES_PASSWORD",
        "SQL_HOST": "POSTGRES_HOST",
        "SQL_PORT": "POSTGRES_PORT",
    },
    postgres_image_tag = "17",
)

###
# Scripts executed at build time. These generate source files
###

# Generate schema files
sh_with_runfiles_binary(
    name = "diesel_print_schema",
    args = [
        "print-schema",
        # Do not filter the tables, some of them have foreign keys referring to "external" tables
        # "--only-tables",
        # "finances_investments",
        "--database-url",
        "$$POSTGRES_URL",
        "> $$BUILD_WORKSPACE_DIRECTORY/" + package_name() + "/src/schema/schema_postgres.rs",
    ],
    tool = "@diesel_cli",
)

# Generate constants.rs file
sh_with_runfiles_binary(
    name = "gen_constants_bin",
    args = [
        "--output-file",
        "$$BUILD_WORKSPACE_DIRECTORY/" + package_name() + "/src/constants.rs",
        "--database-url",
        "$$POSTGRES_URL",
    ],
    tool = "//libraries/finances/accounts/rust:gen_constants",
)

with_postgres_run(
    name = "codegen",
    # First migrate,then print the schema
    binaries = [
        "//libraries/finances/investments/django_finances_investments:migrate",
        ":diesel_print_schema",
        ":gen_constants_bin",
    ],
    env = {
        "SQL_ENGINE": "django.db.backends.postgresql",
    },
    env_transpose = {
        "SQL_DATABASE": "POSTGRES_DB",
        "SQL_USER": "POSTGRES_USER",
        "SQL_PASSWORD": "POSTGRES_PASSWORD",
        "SQL_HOST": "POSTGRES_HOST",
        "SQL_PORT": "POSTGRES_PORT",
    },
    postgres_image_tag = "17",
    tags = [
        "manual",
        "update",
    ],
)

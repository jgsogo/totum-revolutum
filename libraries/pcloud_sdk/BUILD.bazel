load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_test_suite")
load("@totum_revolutum//bazel/rust:defs.bzl", "rust_library_tests_and_docs")

rust_library_tests_and_docs(
    name = "pcloud_sdk",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    all_features = {
        "cli": [
            "cli",
            "indicatif",
        ],
        "indicatif": ["indicatif"],
        "test_utils": ["test_utils"],
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    test_data = glob(["resources/**/*.*"]),
    deps = all_crate_deps(
        normal = True,
    ),
)


load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@totum//bazel/rust:defs.bzl", "rust_library_tests_and_docs")

rust_library_tests_and_docs(
    name = "pcloud_sdk",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    all_features = {
        "cli": [
            "cli",
            "use_indicatif",
        ],
        "use_indicatif": ["use_indicatif"],
        "test_utils": ["test_utils"],
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    test_data = glob(["resources/**/*.*"]),
    deps = all_crate_deps(
        normal = True,
    ) + [
        "@totum//libraries/http_utils",
    ],
)

rust_binary(
    name = "cli",
    srcs = glob(["src/cli/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "cli",
        "use_indicatif",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":pcloud_sdk",
        "@totum//libraries/http_utils",
    ],
)

load("@crates_libraries//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@totum//bazel/rust:defs.bzl", "rust_library_tests_and_docs")

rust_library_tests_and_docs(
    name = "filesystem_pcloud",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    test_deps = [
        "@crates_libraries//:anyhow",
        "@crates_libraries//:headers",
    ],
    test_suite_deps = [
        "@crates_libraries//:anyhow",
        "@crates_libraries//:headers",
    ],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "@totum//libraries/filesystem",
        "@totum//libraries/pcloud_sdk",
    ],
)

rust_binary(
    name = "example/copy_file",
    srcs = ["examples/copy_file.rs"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":filesystem_pcloud",
        "@crates_libraries//:anyhow",
        "@totum//libraries/filesystem",
        "@totum//libraries/pcloud_sdk",
    ],
)

"""
Configure LLVM toolchains
"""

bazel_dep(name = "toolchains_llvm", version = "1.5.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.0")
bazel_dep(name = "spdlog", version = "1.15.3")
bazel_dep(name = "catch2", version = "3.10.0")
bazel_dep(name = "rules_qt")
local_path_override(
    module_name = "rules_qt",
    path = "third_party/@rules_qt",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

STDUUID_VERSION = "1.2.3"

http_archive(
    name = "stduuid",
    build_file = "//bazel/external:BUILD.stduuid.bazel",
    sha256 = "b1176597e789531c38481acbbed2a6894ad419aab0979c10410d59eb0ebf40d3",
    strip_prefix = "stduuid-{}".format(STDUUID_VERSION),
    type = "tar.gz",
    urls = ["https://github.com/mariusbancila/stduuid/archive/refs/tags/v{}.tar.gz".format(STDUUID_VERSION)],
)

# LLVM Versions and platforms
# https://github.com/bazel-contrib/toolchains_llvm/blob/master/toolchain/internal/llvm_distributions.bzl
LLVM_VERSION = "19.1.7"

###############################################################################
# L L V M
#
# https://github.com/bazel-contrib/toolchains_llvm/blob/master/tests/MODULE.bazel
###############################################################################
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

# LLVM toolchain.
llvm.toolchain(
    llvm_version = LLVM_VERSION,
)
use_repo(llvm, "llvm_toolchain")
use_repo(llvm, "llvm_toolchain_llvm")  # if you depend on specific tools in scripts

register_toolchains("@llvm_toolchain//:all")

#####
# Qt
#####
qt = use_extension("@rules_qt//:extensions.bzl", "qt")
qt.configure(qt_version = "6.9.2")
use_repo(qt, "qt_mac_clang_64")

# register_toolchains(
#     "@rules_qt//tools:all",
#     dev_dependency = True,
# )

#####
# Other extensions
#####

libpqxx_non_module_dependencies = use_extension("//third_party/libpqxx:extensions.bzl", "non_module_dependencies")
use_repo(libpqxx_non_module_dependencies, "libpqxx")

tl_expected_non_module_dependencies = use_extension("//third_party/tl-expected:extensions.bzl", "non_module_dependencies")
use_repo(tl_expected_non_module_dependencies, "tl-expected")

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": [
    "jgsogo"
  ],
  "cargo": {
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "enabledManagers": [
    "bazel",
    "bazel-module",
    "bazelisk",
    "cargo",
    "pre-commit",
    "pip-compile",
    "npm",
    "github-actions"
  ],
  "extends": [
    "github>renovatebot/.github",
    ":dependencyDashboard",
    ":enablePreCommit"
  ],
  "packageRules": [
    {
      "description": [
        "By default, disable everything. This is overridden by specific rules below this."
      ],
      "enabled": false,
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "automerge": false,
      "description": [
        "\ud83d\udea8 Security updates: always fast-tracked"
      ],
      "enabled": true,
      "matchUpdateTypes": [
        "security"
      ],
      "prPriority": 100,
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": [
        "\u26a1 Patch updates: slightly prioritized"
      ],
      "enabled": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "prPriority": 10
    },
    {
      "description": [
        "\ud83d\udce6 Minor updates: normal priority"
      ],
      "enabled": true,
      "matchUpdateTypes": [
        "minor"
      ],
      "prPriority": 0
    },
    {
      "description": [
        "\ud83d\udca5 Major updates: lowest priority and slower"
      ],
      "enabled": true,
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "prPriority": -10,
      "schedule": [
        "* 11 * * 2"
      ]
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-pre-commits):",
      "description": [
        "Update pre-commits"
      ],
      "enabled": true,
      "groupName": "pre-commit hooks",
      "matchManagers": [
        "pre-commit"
      ]
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-github-actions):",
      "description": [
        "Update github-actions"
      ],
      "enabled": true,
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-bazel):",
      "description": [
        "Bazel related updates"
      ],
      "enabled": true,
      "groupName": "bazel (non-breaking)",
      "matchManagers": [
        "bazel",
        "bazel-module",
        "bazelisk"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "description": [
        "Bazel major updates"
      ],
      "enabled": true,
      "matchManagers": [
        "bazel",
        "bazel-module",
        "bazelisk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-bazel_dep):",
      "description": [
        "Grouped updates for non-major bazel module deps"
      ],
      "enabled": true,
      "groupName": "bazel modules (non-breaking)",
      "matchDepTypes": [
        "bazel_dep"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-rust):",
      "description": [
        "Individual Rust crate updates"
      ],
      "enabled": true,
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-npm):",
      "description": [
        "Individual NPM updates"
      ],
      "enabled": true,
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-rust):",
      "description": [
        "Grouped updates for patch and minor Rust deps"
      ],
      "enabled": true,
      "groupName": "rust (non-breaking)",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-npm):",
      "description": [
        "Grouped updates for patch and minor NPM deps"
      ],
      "enabled": true,
      "groupName": "npm (non-breaking)",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-python):",
      "description": [
        "Enable individual Python package updates"
      ],
      "enabled": true,
      "matchManagers": [
        "pip-compile"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "automerge": false,
      "commitMessagePrefix": "chore(deps-python):",
      "description": [
        "Grouped updates for patch and minor Python deps"
      ],
      "enabled": true,
      "groupName": "python (non-breaking)",
      "matchManagers": [
        "pip-compile"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    }
  ],
  "pip-compile": {
    "lockFileMaintenance": {
      "enabled": false
    }
  },
  "prConcurrentLimit": 1,
  "rebaseWhen": "conflicted",
  "schedule": [
    "* 10 * * 1",
    "* 14 * * 3",
    "* 11 * * 5"
  ],
  "timezone": "Europe/Madrid"
}

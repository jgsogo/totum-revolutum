{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":preserveSemverRanges",
    "group:all",
    "schedule:monthly",
    ":maintainLockFilesMonthly"
  ],
  "lockFileMaintenance": {
    "commitMessageAction": "Update",
    "extends": [
      "group:all"
    ]
  },
  "rebaseWhen": "automerging",
  "separateMajorMinor": false
}

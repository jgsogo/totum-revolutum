load("@npm//:defs.bzl", "npm_link_all_packages")

# Link all packages from the /MODULE.bazel npm_translate_lock(name = "npm") and also packages from
# manual /MODULE.bazel npm_import rules to bazel-bin/node_modules as well as the virtual store
# bazel-bin/node_modules/.aspect_rules_js since /pnpm-lock.yaml is the root of the pnpm workspace
npm_link_all_packages(name = "node_modules")

genrule(
    name = "stable_build_scm_revision",
    outs = ["stable_build_scm_revision.txt"],
    cmd_bash = """
        h=$$(grep ^STABLE_BUILD_SCM_REVISION bazel-out/stable-status.txt | cut -d' ' -f2 || echo "totum-revolutum");
        echo "$$h" > $@
    """,
    # we need this to be able to read `bazel-out/stable-status.txt`
    stamp = 1,
    visibility = ["//:__subpackages__"],
)

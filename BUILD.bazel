load("@npm//:defs.bzl", "npm_link_all_packages")
load("//bazel:value_from_stable_status.bzl", "value_from_stable_status")

# Link all packages from the /MODULE.bazel npm_translate_lock(name = "npm") and also packages from
# manual /MODULE.bazel npm_import rules to bazel-bin/node_modules as well as the virtual store
# bazel-bin/node_modules/.aspect_rules_js since /pnpm-lock.yaml is the root of the pnpm workspace
npm_link_all_packages(name = "node_modules")

value_from_stable_status(
    name = "stable_build_scm_revision",
    default = "totum-revolutum",
    key = "STABLE_BUILD_SCM_REVISION",
    visibility = ["//:__subpackages__"],
)
